{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure Debug",
      "type": "shell",
      "command": "cmake -B build/cortex-debug -DCMAKE_TOOLCHAIN_FILE=cmake/gcc-arm-toolchain.cmake -DCMAKE_BUILD_TYPE=Debug",
      "problemMatcher": ["$gcc"],
      "group": "none"
    },
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "cmake --build build/cortex-debug --parallel $(nproc)",
      "dependsOn": "Configure Debug",
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "Flash",
      "type": "shell",
      "command": "cmake --build build/cortex-debug --target flash",
      "dependsOn": "Build Debug",
      "problemMatcher": [],
      "group": "none"
    },
    {
      "label": "OpenOCD Server",
      "type": "shell",
      "command": "cmake --build build/cortex-debug --target debug",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
